STORAGE_POSTS_KEY=@pixelgram_posts
STORAGE_FAVORITES_KEY=@pixelgram_favorites
STORAGE_SETTINGS_KEY=@pixelgram_settings

# Notification Configuration (for future use)
EXPO_PUSH_TOKEN=
